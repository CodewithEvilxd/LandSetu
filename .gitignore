# ==========================================
# LandSetu Git Ignore Configuration
# ==========================================

# 1. Node Modules & Dependencies (CRITICAL: Do NOT push to GitHub)
node_modules/
*/node_modules/
**/node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# 2. Build Outputs & Bundles
dist/
*/dist/
**/dist/
build/
*/build/
**/build/
.vite/
*/.vite/
**/.vite/

# 3. Environment & Secrets
.env
*.env
.env.*
!.env.example
backend/.env
backend/*.env
frontend/.env
frontend/*.env

# 4. Database & Storage
*.db
!**/landsetu.db
*.db-journal
*.sqlite
*.sqlite3
backend/data/*.db-journal


# 5. Uploads & Temporary Media (Keep directory structure with .gitkeep)
backend/uploads/records/*
!backend/uploads/records/.gitkeep

# 6. Python Bytecode, Caches & Virtual Environments
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
.pytest_cache/
.coverage

# 7. Agent & Workspace Local Data
/.agents
.agents/
**/.agents/
chrome_out.png

# 8. Logs & Diagnostic Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 9. IDE & OS Artifacts
.vscode/
.idea/
.gemini/
.DS_Store
Thumbs.db
Desktop.ini
__MACOSX/
*/__MACOSX/
**/__MACOSX/
components of land setu/
*/components of land setu/
**/components of land setu/