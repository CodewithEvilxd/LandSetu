{
  "name": "landsetu-backend",
  "version": "1.0.0",
  "description": "Authoritative unified backend API for LandSetu National Land Governance Platform",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node --experimental-sqlite dist/server.js",
    "seed": "tsx src/db/seed.ts",
    "train:ai": "python ../ai/train.py",
    "test:api": "tsx tests/api.test.ts",
    "test": "tsx tests/api.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
